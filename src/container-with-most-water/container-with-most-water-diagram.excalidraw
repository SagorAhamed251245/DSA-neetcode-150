      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Two-Pointer Algorithm Steps",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "version": 1,
      "id": "steps-text",
      "x": 70,
      "y": 715,
      "width": 560,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2037,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1. Initialize l=0, r=8 (both ends)\n2. Calculate: h=min(1,7)=1, w=8, area=8\n3. Since h[l] < h[r], move l++\n4. Repeat until l meets r\n5. Track maximum area found\n6. Return maxA = 49",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
    },
