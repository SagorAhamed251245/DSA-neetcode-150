      "link": null,
      "locked": false,
      "text": "Encoding (length#word pattern):\n\nInput: [\"hello\", \"world\"]\n\"hello\" -> 5#hello (length 5)\n\"world\" -> 5#world (length 5)\n\nResult: \" 5#hello 5#world\"\n\nPattern: space + length + # + word",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
