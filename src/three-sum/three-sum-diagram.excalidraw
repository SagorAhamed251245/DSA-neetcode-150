      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Walkthrough with [-1,0,1,2,-1,-4]:\ni=-1: l=0, r=5 → sum=-1+0+2=1 → l++\n      l=1, r=5 → sum=-1+1+2=2 → l++\n      ... no triplet found\ni=0:  l=2, r=5 → sum=0+1+2=3 → l++\nFound: [-1,0,1] and [-1,-1,2]",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
    },
