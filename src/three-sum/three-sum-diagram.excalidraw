    {
      "type": "text",
      "version": 1,
      "id": "algo-text",
      "x": 70,
      "y": 315,
      "width": 460,
      "height": 170,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 13020,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Two-Pointer + Sort Algorithm:\n\n1. Sort array: [-4,-1,-1,0,1,2]\n2. For each i:\n   - Skip duplicates (i > 0 && a == sorted[i-1])\n   - Set l = i+1, r = end\n   - While l < r:\n     • sum = a + sorted[l] + sorted[r]\n     • sum > 0 → r--\n     • sum < 0 → l++\n     • sum == 0 → found triplet!\n       Add [a, l, r], skip duplicates",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
    },
