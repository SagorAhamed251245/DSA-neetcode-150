      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1. Build prefix sum matrix O(m*n)\n   for each cell (i,j):\n     prefix[i][j] = matrix + top + left - topLeft\n\n2. Answer queries O(1)\n   sumRegion = total - top - left + topLeft",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "index": "b0U",
      "containerId": null,
      "originalText": "1. Build prefix sum matrix O(m*n)\n   for each cell (i,j):\n     prefix[i][j] = matrix + top + left - topLeft\n\n2. Answer queries O(1)\n   sumRegion = total - top - left + topLeft",
      "autoResize": true,
      "lineHeight": 1.130952380952381
    },
