    {
      "type": "text",
      "version": 1,
      "id": "formula-build",
      "x": 70,
      "y": 475,
      "width": 310,
      "height": 65,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1075,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Build Prefix:\nprefix[i][j] = matrix[i][j]\n  + prefix[i-1][j]\n  + prefix[i][j-1]\n  - prefix[i-1][j-1]",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "index": "b0C",
      "containerId": null,
      "originalText": "Build Prefix:\nprefix[i][j] = matrix[i][j]\n  + prefix[i-1][j]\n  + prefix[i][j-1]\n  - prefix[i-1][j-1]",
      "autoResize": true,
      "lineHeight": 0.8571428571428571
    },
    {
      "type": "text",
      "version": 1,
      "id": "formula-query",
      "x": 420,
      "y": 475,
      "width": 310,
      "height": 65,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1076,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Query sumRegion(r1,c1,r2,c2):\n= prefix[r2][c2]\n  - prefix[r1-1][c2]\n  - prefix[r2][c1-1]\n  + prefix[r1-1][c1-1]",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "index": "b0D",
      "containerId": null,
      "originalText": "Query sumRegion(r1,c1,r2,c2):\n= prefix[r2][c2]\n  - prefix[r1-1][c2]\n  - prefix[r2][c1-1]\n  + prefix[r1-1][c1-1]",
      "autoResize": true,
      "lineHeight": 0.8571428571428571
