      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1. Same counting, but track candidate during insertion\n2. Update candidate whenever count > current max\n3. Single pass - more efficient!\n\nWalkthrough: [2,2,1,1,1,2,2]\n2 appears 4 times (majority of 7)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
    },
