      "link": null,
      "locked": false,
      "text": "Two-Pointer Algorithm:\nk = 0 (write pointer)\n\n0 ≠ 2 → nums[0]=0, k=1\n1 ≠ 2 → nums[1]=1, k=2\n2 = 2 → skip\n2 = 2 → skip\n3 ≠ 2 → nums[2]=3, k=3\n4 ≠ 2 → nums[3]=4, k=4\n5 ≠ 2 → nums[4]=5, k=5",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top"
    },
